<ui:FluentWindow x:Class="EnvVarViewer.ConfirmDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:EnvVarViewer"
        mc:Ignorable="d"
        Title="Confirm Delete"
        Width="400" Height="250"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <ui:TitleBar
            Title="Confirm Delete"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Icon="icon.ico"/>

        <StackPanel HorizontalAlignment="Center"
                    Margin="0,60,0,0">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="18">
                <Run Text="Confirm to delete "/>
                <Run Text="{Binding VariableName}"/>
                <Run Text="?"/>
            </TextBlock>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="16" Margin="0,10,0,0"
                       Text="{Binding VariableDescription}"
                       TextWrapping="Wrap"
                       MaxWidth="350"/>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="20" 
                       FontWeight="Bold"
                       Margin="0,20,0,0"
                       Text="{Binding WarningMessage}"
                       TextWrapping="Wrap"
                       MaxWidth="350"
                       Foreground="Red"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,80,0,30">
            <ui:Button Content="Confirm"
                       FontSize="24"
                       Width="80"
                       Height="40"
                       Command="{Binding ConfirmCommand}"
                       IsEnabled="{Binding CanConfirm}"
                       Margin="0,0,40,0"/>
            <ui:Button Content="Cancel"
                       FontSize="24"
                       Width="80"
                       Height="40"
                       Command="{Binding CancelCommand}"
                       Appearance="Secondary"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>