<ui:FluentWindow x:Class="EnvVarViewer.AddModifyEnvVarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:EnvVarViewer.ViewModels"
        Title="Add/Modify Environment Variable" Height="250" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="White">
    <!-- Main layout grid with margin adjustment -->
    <Grid Margin="0,0,0,-6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Environment variable name label -->
        <TextBlock Text="Name:" Grid.Row="1" Grid.Column="0" Margin="10,10,5,5"/>
        <!-- Input field for environment variable name -->
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                Grid.Row="1" Grid.Column="1" Margin="5,10,10,5"/>

        <!-- Environment variable value label -->
        <TextBlock Text="Value:" Grid.Row="2" Grid.Column="0" Margin="10,20,5,10"/>
        <!-- Input field for environment variable value -->
        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                Grid.Row="2" Grid.Column="1" Margin="5,20,10,10"/>

        <!-- Environment variable scope label -->
        <TextBlock Text="Scope:" Grid.Row="3" Grid.Column="0" Margin="10,18,5,0"/>
        <!-- Dropdown selector for environment variable scope (Process/User/System) -->
        <ComboBox SelectedIndex="{Binding SelectedScopeIndex}" 
                  Grid.Row="3" Grid.Column="1" Margin="5,18,10,0">
            <ComboBoxItem Content="Process"/>
            <ComboBoxItem Content="User"/>
            <ComboBoxItem Content="System"/>
        </ComboBox>

        <!-- Window title bar with application icon -->
        <ui:TitleBar
            Title="Add/Modify Environment Variable"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Icon="icon.ico" />

        <!-- Save button container -->
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ui:Button Content="Save" Command="{Binding SaveCommand}"
                       Height="40" Width="80"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>