<ui:FluentWindow 
    x:Class="EnvVarViewer.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Settings" 
    Height="300" Width="400"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    ResizeMode="NoResize">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar
            Title="Settings"
            Grid.Row="0" />

        <Grid Grid.Row="1" Grid.RowSpan="4" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Theme Settings" FontSize="16" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,15"/>

            <StackPanel Grid.Row="1" Orientation="Vertical">
                <RadioButton x:Name="LightThemeRadio" Content="Light Mode" GroupName="Theme" Margin="0,5" Checked="ThemeRadio_Checked" Tag="Light"/>
                <RadioButton x:Name="DarkThemeRadio" Content="Dark Mode" GroupName="Theme" Margin="0,5" Checked="ThemeRadio_Checked" Tag="Dark"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ui:Button Content="OK" Click="OKButton_Click" Width="70" Height="35" Margin="0,0,10,0"/>
                <ui:Button Content="Cancel" Click="CancelButton_Click" Width="70" Height="35"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
