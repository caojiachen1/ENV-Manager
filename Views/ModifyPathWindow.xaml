<ui:FluentWindow x:Class="EnvVarViewer.ModifyPathWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:EnvVarViewer.ViewModels"
        Title="Modify Path" Height="500" Width="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- TitleBar -->
            <RowDefinition Height="*" />
            <!-- Path ListBox -->
            <RowDefinition Height="Auto" />
            <!-- New Path TextBox and Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Title="Modify Path" Grid.Row="0" Grid.ColumnSpan="3" />

        <!-- Path ListBox with virtualization for better performance -->
        <ListBox Name="PathListBox" Grid.Row="1" Grid.ColumnSpan="3" Margin="10" 
                 ItemsSource="{Binding PathEntries}" 
                 SelectedItem="{Binding SelectedPath}"
                 PreviewMouseDoubleClick="OnPathListBoxDoubleClick"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True" />

        <!-- New Path TextBox and Buttons Row -->
        <TextBox Name="NewPathTextBox" Grid.Row="2" Grid.Column="0" Margin="10,5" 
                 Text="{Binding NewPathEntry, UpdateSourceTrigger=PropertyChanged}" />
        <ui:Button Name="AddButton" Grid.Row="2" Grid.Column="1" Margin="5" Width="60" 
                  Command="{Binding AddPathCommand}">Add</ui:Button>
        <ui:Button Name="RemoveButton" Grid.Row="2" Grid.Column="2" Margin="5" Width="80" 
                  Command="{Binding RemovePathCommand}">Remove</ui:Button>

        <!-- Bottom Buttons Row -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" 
                   HorizontalAlignment="Center" Margin="0,5,0,30">
            <ui:Button Name="BrowseButton" Margin="5" Width="80" 
                      Command="{Binding BrowsePathCommand}">Browse</ui:Button>
            <ui:Button Name="SaveButton" Margin="5" Width="80" 
                      Command="{Binding SavePathCommand}">Save</ui:Button>
        </StackPanel>

        <!-- Status Label (overlay) -->
        <Label Name="StatusLabel" Grid.Row="3" Grid.ColumnSpan="3" 
               Content="{Binding StatusMessage}" 
               HorizontalAlignment="Left" VerticalAlignment="Bottom" 
               Margin="10,0,0,5" Foreground="Green"/>
    </Grid>
</ui:FluentWindow>