<ui:FluentWindow x:Class="EnvVarViewer.ModifyPathWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:EnvVarViewer.ViewModels"
        Title="Modify Path" Height="400" Width="500"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- TitleBar -->
            <RowDefinition Height="*" />
            <!-- Path ListBox -->
            <RowDefinition Height="Auto" />
            <!-- New Path TextBox and Buttons -->
            <RowDefinition Height="Auto" />
            <!-- Save Button -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Title="Modify Path" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" />

        <!-- Path ListBox -->
        <ListBox Name="PathListBox" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="10" 
                 ItemsSource="{Binding PathEntries}" 
                 SelectedItem="{Binding SelectedPath}"
                 VerticalAlignment="Stretch"
                 PreviewMouseDoubleClick="OnPathListBoxDoubleClick">
        </ListBox>

        <!-- New Path TextBox -->
        <TextBox Name="NewPathTextBox" Grid.Row="2" Grid.Column="0" Margin="10,0,10,10" 
                 Text="{Binding NewPathEntry, UpdateSourceTrigger=PropertyChanged}" 
                 VerticalAlignment="Stretch"/>

        <!-- Browse Button -->
        <ui:Button Name="BrowseButton" Grid.Row="3" Grid.Column="0" Margin="10,0,10,10" Width="80" 
                Command="{Binding BrowsePathCommand}">Browse</ui:Button>

        <!-- Add Button -->
        <ui:Button Name="AddButton" Grid.Row="2" Grid.Column="1" Margin="0,0,10,10" Width="50" 
                  Command="{Binding AddPathCommand}">Add</ui:Button>

        <!-- Remove Button -->
        <ui:Button Name="RemoveButton" Grid.Row="2" Grid.Column="2" Margin="0,0,10,10" Width="80" 
                  Command="{Binding RemovePathCommand}">Remove</ui:Button>

        <!-- Save Button -->
        <ui:Button Name="SaveButton" Grid.Row="3" Grid.Column="2" Margin="0,0,0,10" Width="60" 
                  Command="{Binding SavePathCommand}">Save</ui:Button>

        <!-- Status Label -->
        <Label Name="StatusLabel" Grid.Row="3" Grid.Column="0" Margin="10,10,0,10" 
               Content="{Binding StatusMessage}" 
               HorizontalAlignment="Left" VerticalAlignment="Center" 
               Foreground="Green"/>

    </Grid>
</ui:FluentWindow>