<ui:FluentWindow 
    x:Class="EnvVarViewer.BackupRestoreWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Backup/Restore" 
    Height="650" Width="600"
    ui:Design.Background="#FF202020"
    ui:Design.Foreground="#FFFFFFFF"
    ExtendsContentIntoTitleBar="True"
    Foreground="#FFFFFFFF"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    
    <Grid Margin="0,0,0,-6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar
            Title="Backup/Restore"
            Grid.Row="0"
            Icon="icon.ico" />

        <!-- 备份选项 -->
        <GroupBox Header="Backup Options" Grid.Row="1" Margin="0,10,0,0">
            <StackPanel Margin="10">
                <CheckBox Content="User Var" IsChecked="{Binding BackupUserVars}" Margin="0,5,0,0"/>
                <CheckBox Content="Sys Var" IsChecked="{Binding BackupSystemVars}" Margin="0,5,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <ui:Button Content="Create backup" Click="BackupButton_Click" Width="120" Height="35" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding BackupStatus}" VerticalAlignment="Center" Foreground="Green"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 恢复选项 -->
        <GroupBox Header="Restore Options" Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Margin="10">
                <CheckBox x:Name="RestoreUserVarsCheckBox" Content="User Var" IsChecked="{Binding RestoreUserVars}" Margin="0,5,0,0"/>
                <CheckBox x:Name="RestoreSystemVarsCheckBox" Content="Sys Var" IsChecked="{Binding RestoreSystemVars}" Margin="0,5,0,0"/>
                <CheckBox x:Name="OverwriteExistingCheckBox" Content="Override existing" IsChecked="{Binding OverwriteExisting}" Margin="0,5,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <ui:TextBox x:Name="RestoreFilePathTextBox" PlaceholderText="Choose backup" Width="350" IsReadOnly="True" Margin="0,0,10,0"/>
                    <ui:Button x:Name="BrowseButton" Content="Explore" Click="BrowseButton_Click" Width="80" Height="35"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <ui:Button x:Name="RestoreButton" Content="Restore from backup" Click="RestoreButton_Click" Width="150" Height="35" Margin="0,0,10,0"/>
                    <ui:TextBlock x:Name="RestoreStatusText" Text="{Binding RestoreStatus}" VerticalAlignment="Center" Foreground="Green"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 备份文件预览 -->
        <GroupBox Header="Backup preview" Grid.Row="4" Margin="0,10,0,0">
            <ScrollViewer Margin="5">
                <TextBlock x:Name="PreviewTextBlock" TextWrapping="Wrap"/>
            </ScrollViewer>
        </GroupBox>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,10,10">
            <ui:Button Content="Close" Click="CloseButton_Click" Width="80" Height="35"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>